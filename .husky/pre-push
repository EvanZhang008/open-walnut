# Pre-push gate (committed; runs for everyone who installs deps).
#
# 1. TypeScript type-check: matches CI's `npm run lint` (tsc --noEmit; `bun run lint` here).
#    The local dev build uses tsup/esbuild, which ONLY transpiles and SKIPS
#    type-checking, so type errors stay invisible locally and surface only in
#    CI. This makes a local push fail for the same reason CI would, before the
#    error reaches the remote.
#
# 2. Committed-tree bundle check — the worktree tsc above can PASS while HEAD
#    is broken (the fix for a cross-file dangling import sits uncommitted in
#    the worktree). Bundling HEAD's import graph catches that in <1s.
#
# 3. An OPTIONAL local-only scanner (scripts/local/scan-sensitive.sh, gitignored,
#    or the file `git config walnut.prepushScanner` names) runs afterwards if
#    present — used by this repo's maintainer to scan for private content before
#    pushing to the public mirror. Absent for everyone else, so this hook
#    degrades to just the type-check.
#
# 4. The test gate, last because it is the slowest: see scripts/push-gate.sh.
#
# Bypass everything with `git push --no-verify` (not recommended).

# The refs being pushed, read once: the scanner and the test gate below both read them.
refs=$(cat)

# A tool that already type-checked the exact tree it pushes names that tree in
# WALNUT_PUSH_TYPECHECKED_TREE, and the hook does not check it again (2026-11-11: on a busy machine a
# push spent 25 minutes repeating the check its land had just passed, and the pushes queued behind
# it gave up). Only a clean checkout of that very tree skips; anything else is checked here.
checked_tree=${WALNUT_PUSH_TYPECHECKED_TREE:-}
if [ -n "$checked_tree" ] && [ "$checked_tree" = "$(git rev-parse -q --verify 'HEAD^{tree}' 2>/dev/null)" ] \
  && [ -z "$(git status --porcelain 2>/dev/null)" ]; then
  echo "✓ Type-check: this tree passed one before the push (WALNUT_PUSH_TYPECHECKED_TREE), not run again."
else
  echo "Type-checking before push (tsc --noEmit)…"
  if ! bun run --silent lint; then
    echo ""
    echo "Push blocked: TypeScript errors above (CI would fail too)."
    echo "Fix them, or bypass with: git push --no-verify"
    exit 1
  fi
  echo "✓ Type-check passed."
fi

bash scripts/check-committed-bundle.sh || exit 1

# Optional local sensitive-content scanner: forward stdin (the pre-push refs) and the
# hook's arguments (the remote's name and url: the scanner checks only what is about
# to become public). scripts/local/ is gitignored, so a clone or a worktree has none:
# there the scanner is the file git config walnut.prepushScanner names, and a named
# scanner that is missing blocks the push instead of skipping the scan.
scanner=scripts/local/scan-sensitive.sh
[ -x "$scanner" ] || scanner=$(git config --path --get walnut.prepushScanner || true)
if [ -n "$scanner" ]; then
  if [ ! -x "$scanner" ]; then
    echo "Push blocked: walnut.prepushScanner names $scanner, which is not there."
    exit 1
  fi
  printf '%s\n' "$refs" | "$scanner" "$@" || exit 1
fi

# 4. The test gate (scripts/push-gate.sh): CI's quick and frontend tiers and the browser specs a
#    push to main touches, on the commit being pushed, on GitHub's runners (a hidden
#    refs/gate/<sha> ref and .github/workflows/push-gate.yml). Off unless `git config walnut.pushGate` is true, so a
#    contributor's push is unchanged.
printf '%s\n' "$refs" | bash scripts/push-gate.sh "$@" || exit 1
