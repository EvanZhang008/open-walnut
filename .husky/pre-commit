# Pre-commit gate (committed, runs for everyone). Intentionally light: the type check runs at
# push time in .husky/pre-push.
#
# 1. The leak scan of the staged change (scripts/leak-scan/scan-git.mjs): credentials, private
#    words and shapes, private data files, screenshots outside the asset folders. A hit names
#    the rule and the file and line; reword it and commit again. On the maintainer's machines it
#    also needs the private rules and gitleaks, and refuses without them.
bun scripts/leak-scan/scan-git.mjs --staged || exit 1

# 2. Parse-check staged .ts/.tsx blobs (<1s). Guards against the mangled-hunk class where the
#    committed content is syntactically broken while the worktree compiles: see the script header.
if [ -x scripts/check-staged-parse.sh ]; then
  scripts/check-staged-parse.sh || exit 1
fi
