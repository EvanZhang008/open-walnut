{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@open-walnut/core": ["../src/core/types"],
      "@open-walnut/task-query": ["../src/core/task-query"],
      "@open-walnut/letter-frame": ["../src/core/human-inbox/letter-frame"],
      "@open-walnut/pending-markup": ["../src/core/stream/pending-markup"],
      "@open-walnut/service-url": ["../src/core/service-url"],
      "@open-walnut/mail-folder-name": ["../src/integrations/mail/folder-name"],
      "@open-walnut/content-item": ["../src/core/content-actions/content-item"],
      "@open-walnut/compaction-notice": ["../src/core/stream/compaction-notice"],
      "@open-walnut/hint-format": ["../src/core/hints/hint-format"],
      "@open-walnut/keeps-threads": ["../src/core/org/keeps-threads"],
      "@open-walnut/budget-engines": ["../src/core/usage/budget-engines"],
      "@open-walnut/model-line": ["../src/core/usage/model-line"],
      "@open-walnut/search-transcript": ["../src/core/task-search-transcript"],
      "@open-walnut/host-problem": ["../src/core/hosts/host-problem"],
      "@open-walnut/notice-audience": ["../src/core/notifications/audience"],
      "@open-walnut/found-host-offer": ["../src/core/hosts/found-host-offer"],
      "@open-walnut/ask-list": ["../src/core/sessions/ask-list"],
      "@open-walnut/org-tree": ["../src/core/org/org-tree"],
      "@open-walnut/org-avatars": ["../src/core/org/avatars/index"],
      "@open-walnut/user-status": ["../src/core/user-status"],
      "@open-walnut/board-summary-text": ["../src/core/boards/board-summary-text"],
      "@open-walnut/message-about": ["../src/core/org/message-about"],
      "@open-walnut/reply-thread": ["../src/core/org/reply-thread"],
      "@open-walnut/thread-view": ["../src/core/org/thread-view"],
      "@open-walnut/live-activity": ["../src/core/live-activity"],
      "@open-walnut/terminal-key": ["../src/core/terminal-key"],
      "@open-walnut/brief-structure": ["../src/core/sessions/brief-structure"],
      "@open-walnut/brief-fresh": ["../src/core/sessions/brief-fresh"],
      "@open-walnut/companion-keep": ["../src/core/replication/companion-keep"],
      "@open-walnut/history-turn-window": ["../src/lib/history-turn-window"],
      "@open-walnut/transcript-sent-by": ["../src/core/sessions/transcript-sent-by"],
      "@open-walnut/history-injected-banner": ["../src/lib/history-injected-banner"],
      "@open-walnut/history-session-envelope": ["../src/lib/history-session-envelope"],
      "@open-walnut/turn-end-marker": ["../src/lib/turn-end-marker"],
      "@open-walnut/tool-header-text": ["../src/lib/tool-header-text"],
      "@open-walnut/history-walnut-riders": ["../src/lib/history-walnut-riders"],
      "@open-walnut/attachment-headers": ["../src/lib/attachment-headers"],
      "@open-walnut/walnut-added": ["../src/lib/walnut-added"],
      "@open-walnut/composed-framing": ["../src/lib/composed-framing"],
      "@open-walnut/send-targets": ["../src/lib/send-targets"],
      "@open-walnut/three-way-merge": ["../src/lib/three-way-merge"],
      "@open-walnut/mail-subject-pattern": ["../src/integrations/mail/sort-regex-safety"]
    }
  },
  "include": ["src", "../src/types/**/*.d.ts", "../src/integrations/**/*.d.ts"]
}
