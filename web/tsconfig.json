{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@open-walnut/core": ["../src/core/types"],
      "@open-walnut/task-query": ["../src/core/task-query"],
      "@open-walnut/letter-frame": ["../src/core/human-inbox/letter-frame"],
      "@open-walnut/pending-markup": ["../src/core/stream/pending-markup"],
      "@open-walnut/service-url": ["../src/core/service-url"],
      "@open-walnut/compaction-notice": ["../src/core/stream/compaction-notice"],
      "@open-walnut/hint-format": ["../src/core/hints/hint-format"],
      "@open-walnut/budget-engines": ["../src/core/usage/budget-engines"],
      "@open-walnut/search-transcript": ["../src/core/task-search-transcript"],
      "@open-walnut/host-problem": ["../src/core/hosts/host-problem"],
      "@open-walnut/ask-list": ["../src/core/sessions/ask-list"],
      "@open-walnut/org-tree": ["../src/core/org/org-tree"],
      "@open-walnut/user-status": ["../src/core/user-status"],
      "@open-walnut/live-activity": ["../src/core/live-activity"],
      "@open-walnut/companion-keep": ["../src/core/replication/companion-keep"],
      "@open-walnut/history-turn-window": ["../src/lib/history-turn-window"],
      "@open-walnut/history-injected-banner": ["../src/lib/history-injected-banner"],
      "@open-walnut/history-session-envelope": ["../src/lib/history-session-envelope"],
      "@open-walnut/history-walnut-riders": ["../src/lib/history-walnut-riders"],
      "@open-walnut/walnut-added": ["../src/lib/walnut-added"],
      "@open-walnut/three-way-merge": ["../src/lib/three-way-merge"]
    }
  },
  "include": ["src", "../src/types/**/*.d.ts", "../src/integrations/**/*.d.ts"]
}
