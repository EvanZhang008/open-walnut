{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@open-walnut/core": ["../src/core/types"],
      "@open-walnut/task-query": ["../src/core/task-query"],
      "@open-walnut/letter-frame": ["../src/core/human-inbox/letter-frame"]
    }
  },
  "include": ["src", "../src/types/**/*.d.ts"]
}
