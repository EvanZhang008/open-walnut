<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime (which notarization requires) withholds the microphone
     and the calendar from an app unless it claims them here; the Info.plist
     usage strings alone are not enough. Voice input needs the first, the
     calendar view (CalendarBridge.swift) the second. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
