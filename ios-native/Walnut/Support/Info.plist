<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.openwalnut.ios.health-refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Walnut</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>87</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Walnut shows your calendar events alongside tasks in the calendar view. Events are read-only and never leave your device.</string>
	<key>NSCameraUsageDescription</key>
	<string>Walnut uses the camera to scan the pairing QR code from your Walnut console and to take photos you attach to chats and notes.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Walnut reads the Apple Health data you allow and keeps your own Mac up to date, so your AI can answer questions about your sleep, activity, heart and other health data.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Only Walnut's test builds add sample health data, to check that syncing works. The App Store version never changes your Apple Health data.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Walnut connects to the Walnut server you run on your local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Walnut uses the microphone for voice input. Your speech is turned into text by your own Walnut server.</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>mic.fill</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Record and send to your AI</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Voice to Walnut</string>
			<key>UIApplicationShortcutItemType</key>
			<string>dev.openwalnut.ios.voice</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
