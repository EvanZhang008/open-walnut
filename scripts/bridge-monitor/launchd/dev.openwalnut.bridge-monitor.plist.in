<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bridge monitor collector (long-running). Rendered by scripts/bridge-monitor/install.sh.
  KeepAlive restarts it ONLY after a crash (non-zero exit), at most once per
  ThrottleInterval. A clean exit (SIGTERM, bootout) stays down, so this job can
  never turn into a relaunch loop. Never load it with `launchctl submit`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.openwalnut.bridge-monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__APP__/collector.mjs</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__APP__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>Nice</key>
    <integer>5</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__LOGDIR__/collector.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/collector.err.log</string>
</dict>
</plist>
